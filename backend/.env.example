# g2-agent-bridge config
PORT=3050

# LLM provider for the POC. Default: gemini (free tier).
# provider options: gemini | openai | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Optional fallbacks (paid — leave empty for the free POC)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Whisper STT endpoint (runs on your own host (LAN or Tailscale)). Optional for sim text-mode.
# The glasses send raw PCM; the bridge forwards to this Whisper service.
WHISPER_URL=http://<YOUR_WHISPER_HOST>:9100/transcribe
